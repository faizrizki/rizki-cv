# ============================================================
#  Copy file ini jadi .env.local (lokal) dan isi di Vercel
#  (Project Settings -> Environment Variables) untuk produksi.
# ============================================================

# --- Supabase -----------------------------------------------
# Dashboard Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...anon-key
# JANGAN pernah taruh key ini di kode client. Hanya untuk server.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role-key

# --- Login admin CMS ----------------------------------------
# Password untuk masuk ke /admin
ADMIN_PASSWORD=ganti-dengan-password-kuat
# Kunci penandatangan cookie sesi. Buat acak, minimal 32 karakter:
#   openssl rand -hex 32
AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# --- Keep-alive (opsional tapi disarankan) -------------------
# Vercel Cron memanggil /api/keep-alive sekali sehari supaya project
# Supabase gratis tidak di-pause karena dianggap tidak aktif.
# Isi dengan string acak; Vercel otomatis mengirimkannya sebagai
# header Authorization saat cron berjalan, jadi endpoint-nya tidak
# bisa dipanggil sembarang orang. Kalau dibiarkan kosong, endpoint
# tetap jalan tapi terbuka untuk umum.
#   openssl rand -hex 16
CRON_SECRET=
